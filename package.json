{
  "name": "e-tongue-project",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n FE,BE -c cyan,green \"vite\" \"tsx watch server/server.js\"",
    "dev:frontend": "vite",
    "dev:server": "tsx watch server/server.js",
    "build": "vite build",
    "preview": "vite preview",
    "server": "tsx server/server.js",
    "mcp": "node server/mcp-server.js",
    "start": "tsx server/server.js",
    "bridge": "node server/serial-bridge.js",
    "dev:full": "npm run dev",
    "dev:all": "concurrently -n FE,BE,MCP -c cyan,green,magenta \"vite\" \"tsx server/server.js\" \"npm run mcp\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "agent:server": "tsx server/src/index.ts",
    "job:nightly": "tsx server/src/jobs/nightlyRollup.ts",
    "model:train": "node server/scripts/train_model.js",
    "simulate": "node scripts/simulate-device.js",
    "demo": "concurrently -n FE,BE,SIM -c cyan,green,yellow \"vite\" \"tsx server/server.js\" \"node scripts/simulate-device.js turmeric --good\""
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@types/jsonwebtoken": "^9.0.10",
    "axios": "^1.20.0",
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "concurrently": "^10.0.6",
    "cors": "^2.8.6",
    "dotenv": "^18.0.7",
    "express": "^5.3.0",
    "framer-motion": "^14.1.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "lenis": "^1.3.26",
    "lucide-react": "^1.16.0",
    "mongoose": "^9.11.2",
    "node-cron": "^4.6.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hot-toast": "^2.4.1",
    "react-is": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "recharts": "^3.10.1",
    "serialport": "^13.0.0",
    "tailwind-merge": "^2.5.2",
    "three": "^0.186.1",
    "zod": "^4.6.7",
    "zustand": "^5.0.15"
